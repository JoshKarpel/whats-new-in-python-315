[0.0, "o", "\u001b[?2026h\u001b[1;25f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1m        \u001b[1;34f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m\u001b[1m\u001b[4m\u001b]8;;https://peps.python.org/pep-0799/\u001b\\PEP 799\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1m\u001b]8;;\u001b\\: Why in CPython?\u001b[1;59f        \u001b[2;6fpy-spy, austin\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                         \u001b[3;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                     \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[4;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[4;8f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0mprofiler \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m── reads memory ──▶\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m CPython 3.x \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[5;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━┛\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                     \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━━━━┛\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[6;6f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0mwith struct layouts for each version, so every release needs a catch-up release\u001b[7;15f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                              \u001b[8;15f                                                              \u001b[9;6f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1mTachyon\u001b[9;15f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                              \u001b[10;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                          \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m       \u001b[11;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[11;8f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1mprofiling.sampling\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m── _remote_debugging ──▶\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m CPython 3.15 \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m       \u001b[12;6f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━━━━━━━━━━━┛\u001b[12;54f┗━━━━━━━━━━━━━━┛\u001b[13;6f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0mships with the interpreter, so it supports each release on day one\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m    \u001b[13;77f        \u001b[14;6f\u001b[0m\u001b[38;2;248;113;113m\u001b[48;2;0;0;0m\u001b[1mand must be the same minor version as its target\u001b[15;2f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                 \u001b[15;81f         \u001b[16;2f                                                                                        \u001b[17;2f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1m\u001b[2m 1 \u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m\u001b[1m\u001b[2m3.15's Tachyon, 3.14's process\u001b[17;89f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[18;2f\u001b[0m\u001b[38;2;71;85;105m\u001b[48;2;0;0;0m╭──────────────────────────────────────────────────────────────────────────────────────╮\u001b[19;3f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m      \u001b[19;10f  \u001b[19;13f                  \u001b[19;32f   \u001b[19;36f       \u001b[19;44f    \u001b[19;49f \u001b[21;3f      \u001b[21;10f      \u001b[22;5f        \u001b[22;14f    \u001b[22;19f \u001b[23;3f      \u001b[23;10f  \u001b[23;13f                 \u001b[23;31f      \u001b[24;5f                                                                    \u001b[24;74f    \u001b[24;79f \u001b[25;3f      \u001b[25;10f  \u001b[25;13f                  \u001b[25;32f   \u001b[25;36f      \u001b[26;5f        \u001b[26;14f    \u001b[26;19f \u001b[30;84f\u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m1\u001b[0m\u001b[?2026l"]
