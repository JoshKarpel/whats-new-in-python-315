[0.05, "o", "\u001b[?2026h\u001b[1;1f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m\u001b[1m\u001b[4m\u001b]8;;https://peps.python.org/pep-0798/\u001b\\PEP 798\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1m\u001b]8;;\u001b\\: Unpacking in comprehensions \u001b[1;99f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[2;20f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m┏━\u001b[2;80f┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[3;20f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;40;42;54m \u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54mrows \u001b[0m\u001b[38;2;255;121;198m\u001b[48;2;40;42;54m=\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m [\u001b[3;31f\u001b[0m\u001b[38;2;255;184;108m\u001b[48;2;40;42;54m1\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m, \u001b[0m\u001b[38;2;255;184;108m\u001b[48;2;40;42;54m2\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m], [\u001b[0m\u001b[38;2;255;184;108m\u001b[48;2;40;42;54m3\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m, \u001b[0m\u001b[38;2;255;184;108m\u001b[48;2;40;42;54m4\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m], [\u001b[0m\u001b[38;2;255;184;108m\u001b[48;2;40;42;54m5\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m]\u001b[3;50f \u001b[3;79f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;40;42;54m \u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[4;20f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;40;42;54m \u001b[0m\u001b[38;2;139;233;253m\u001b[48;2;40;42;54m\u001b[3mprint\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m([\u001b[0m\u001b[38;2;255;121;198m\u001b[48;2;40;42;54m*\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54mrow \u001b[0m\u001b[38;2;255;121;198m\u001b[48;2;40;42;54mfor\u001b[0m\u001b[38;2;248;248;242m\u001b[48;2;40;42;54m row \u001b[0m\u001b[38;2;255;