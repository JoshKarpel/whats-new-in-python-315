[0.0, "o", "\u001b[?2026h\u001b[1;11f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1mWhy \u001b[1;17f CPython?     \u001b[1;32f   \u001b[1;36f        \u001b[2;11fpy-spy, austin\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                         \u001b[3;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                     \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[4;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[4;13f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0mprofiler \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m── reads memory ──▶\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m CPython 3.x \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[5;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━┛\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                     \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━━━━┛\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                       \u001b[6;11f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0mwith struct layouts for each version, so every release needs a catch-up release\u001b[7;20f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                              \u001b[8;20f                                                              \u001b[9;11f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1mTachyon\u001b[9;20f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                                              \u001b[10;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                          \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┏━━━━━━━━━━━━━━┓\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m       \u001b[11;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[11;13f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1mprofiling.sampling\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m── _remote_debugging ──▶\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m CPython 3.15 \u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┃\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m       \u001b[12;11f\u001b[0m\u001b[38;2;203;213;225m\u001b[48;2;0;0;0m┗━━━━━━━━━━━━━━━━━━━━┛\u001b[12;59f┗━━━━━━━━━━━━━━┛\u001b[13;11f\u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0mships with the interpreter, so it supports each release on day one\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m    \u001b[13;82f        \u001b[14;11f\u001b[0m\u001b[38;2;248;113;113m\u001b[48;2;0;0;0m\u001b[1mand must be the same minor version as its target\u001b[15;2f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m                                 \u001b[15;91f         \u001b[16;2f                                                                                                  \u001b[17;2f\u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;0;0;0m\u001b[1m\u001b[2m 1 \u001b[0m\u001b[38;2;75;139;190m\u001b[48;2;0;0;0m\u001b[1m\u001b[2m3.15's Tachyon, 3.14's process\u001b[17;99f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m \u001b[18;2f\u001b[0m\u001b[38;2;71;85;105m\u001b[48;2;0;0;0m╭────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[19;3f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m      \u001b[19;10f  \u001b[19;13f                  \u001b[19;32f   \u001b[19;36f       \u001b[19;44f    \u001b[19;49f \u001b[21;3f      \u001b[21;10f      \u001b[22;5f             \u001b[22;19f    \u001b[22;24f \u001b[23;3f      \u001b[23;10f  \u001b[23;13f                 \u001b[23;31f      \u001b[24;5f                                                                              \u001b[24;84f    \u001b[24;89f \u001b[25;3f      \u001b[25;10f  \u001b[25;13f                  \u001b[25;32f   \u001b[25;36f      \u001b[26;5f            \u001b[26;18f    \u001b[26;23f \u001b[30;94f\u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m1\u001b[0m\u001b[?2026l"]
