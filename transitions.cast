;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[10;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  a split-flap departure board\u001b[10;86f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m     \u001b[10;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[11;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[11;57f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0mcurl\u001b[11;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[12;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  peels away like a turned page\u001b[12;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[13;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m  cube                                     \u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[14;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  a quarter turn of a cube\u001b[14;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[15;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[15;57f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0mshatter\u001b[15;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[16;53f│\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  cracks like glass and falls away\u001b[16;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[17;53f│\u001b[0m\u001b[38;2;25