[0.0, "o", "\u001b[?2026h\u001b[2;50f\u001b[0m\u001b[38;2;252;211;77m\u001b[48;2;0;0;0m╭────────────────────────────────────────────────╮\u001b[3;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0mgrid transition                               \u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[4;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[48;2;0;0;0m>\u001b[4;54f\u001b[38;2;15;23;42m\u001b[48;2;125;211;252m \u001b[38;2;255;255;255m\u001b[48;2;15;23;42m                                            \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[5;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[5;54f\u001b[48;2;0;0;0moff\u001b[5;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[6;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  no transition: cut straight to it\u001b[6;98f\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[7;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[7;54f\u001b[48;2;0;0;0mrandom\u001b[7;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[8;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  a different one each time\u001b[8;98f\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[9;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m\u001b[1m─── grid effects ─ one at random \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;0;0;0m─────────────\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[10;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;7;89;133m\u001b[1m▸ zoom\u001b[10;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[11;50f│\u