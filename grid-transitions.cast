54f\u001b[48;2;0;0;0mfold\u001b[20;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[21;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  folds up like paper, and unfolds as the grid\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[22;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[22;54f\u001b[48;2;0;0;0mflip\u001b[22;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[23;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  turns over like a card, the grid on its back\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[24;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[24;54f\u001b[48;2;0;0;0mslice\u001b[24;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[25;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m↑ ↓ · Enter · Esc closes                      \u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[26;50f╰────────────────────────────────────────────────╯\u001b[0m\u001b[?2026l"]
