4m\u001b[48;2;0;0;0m  the slide shrinks into its thumbnail\u001b[11;98f\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[12;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;255;212;59m\u001b[48;2;7;89;133m\u001b[1m▸ scale\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;0;0;0m             \u001b[12;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[13;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;148;163;184m\u001b[48;2;7;89;133m\u001b[1m  the slide is scaled down whole into place\u001b[13;98f\u001b[0m\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[14;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[48;2;0;0;0m  expose       \u001b[14;71f  \u001b[14;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[15;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  the others slide in from the edges\u001b[15;98f\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[16;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[48;2;0;0;0m  deal               \u001b[16;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[17;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  the rest of the deck is dealt around it\u001b[17;98f\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[18;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[18;54f\u001b[48;2;0;0;0munpack\u001b[18;98f\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[19;50f│\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;148;163;184m\u001b[48;2;0;0;0m  *section: the others burst out from under it\u001b[38;2;255;255;255m\u001b[48;2;15;23;42m \u001b[38;2;252;211;77m\u001b[48;2;0;0;0m│\u001b[20;50f│\u001b[38;2;255;255;255m\u0